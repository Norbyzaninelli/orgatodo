DATABASE_URL=postgres://orgatodo:orgatodo@localhost:5432/orgatodo
BETTER_AUTH_SECRET=generar-con-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Avisos. Sin estas claves los mensajes se escriben en el log (modo prueba).
RESEND_API_KEY=
EMAIL_FROM="ORGATODO <avisos@tudominio.com>"
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=es_AR
# Protege /api/cron/avisos, que manda los recordatorios programados.
CRON_SECRET=
# Facturación con ARCA: simulado (por defecto, sin salir a internet), homologacion o produccion.
ARCA_MODO=simulado
# Clave para cifrar las claves privadas de los certificados: 32 bytes en hexadecimal (openssl rand -hex 32) o base64.
# Obligatoria en producción; en desarrollo se deriva de BETTER_AUTH_SECRET.
ARCA_CLAVE_CIFRADO=
# Solo modo simulado: categoría de monotributo que devuelve la constancia.
ARCA_SIMULADO_CATEGORIA=C
